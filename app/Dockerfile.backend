FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

# Create a non-root runtime user so the container follows Kubernetes security best practices.
RUN groupadd --system app && useradd --system --gid app --create-home --home-dir /home/app app

# Copy only dependency manifests first to keep Docker layer caching efficient.
COPY src/shared/requirements.txt /app/src/shared/requirements.txt
COPY src/backend/requirements.txt /app/src/backend/requirements.txt

RUN pip install --no-cache-dir -r /app/src/backend/requirements.txt

# Copy backend application source after dependencies are installed.
COPY src/backend /app/src/backend

RUN chown -R app:app /app /home/app

USER app
WORKDIR /app/src/backend

EXPOSE 8000

CMD ["uvicorn", "api:app", "--host", "0.0.0.0", "--port", "8000"]
