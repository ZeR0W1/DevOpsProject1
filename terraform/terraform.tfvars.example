# Authoritative non-secret input template. The guarded Ansible lifecycle copies
# this file to ignored terraform.tfvars and injects the three local values below.

aws_region  = "us-east-1"
name_prefix = "doa"
environment = "staging"

common_tags = {
  Project   = "DevOpsProject1"
  ManagedBy = "Terraform"
}

vpc_cidr           = "10.0.0.0/16"
availability_zones = ["us-east-1b", "us-east-1a"]

eks_cluster_name        = "doa-staging-eks"
eks_cluster_version     = "1.34"
eks_node_instance_types = ["t3.medium"]
eks_node_desired_size   = 3
eks_node_min_size       = 3
eks_node_max_size       = 4

# The guarded Ansible lifecycle replaces these fail-closed placeholders before
# Terraform runs. Route 53 mode instead supplies an existing public hosted zone
# and hostname, while leaving public_imported_certificate_arn null.
public_tls_mode                 = "self_signed"
public_hostname                 = null
public_route53_zone_id          = null
public_imported_certificate_arn = "arn:aws:acm:us-east-1:000000000000:certificate/00000000-0000-0000-0000-000000000000"
github_hooks_ipv4_cidrs         = ["192.0.2.0/32"]
frontend_node_port              = 32081
jenkins_webhook_node_port       = 32080

# Terraform derives the private application bucket name from name_prefix,
# environment, the authenticated AWS account ID, and aws_region. Uncomment only
# when an explicit globally unique override is required.
# bucket_name       = "custom-globally-unique-application-bucket"
worker_topic_name   = "DOAworker"
billing_alarm_name  = "Billing-Over-20-USD"

db_password_secret_name = "project/postgresql/master-password"

# Replaced by Ansible from the encrypted ignored local environment file.
admin_cidr  = "203.0.113.10/32"
admin_email = "admin@example.com"
db_username = "doa_staging_admin"

db_subnet_group_name       = "db-group1"
db_identifier              = "dodb2"
db_name                    = "postgres"
db_engine_version          = "17.6"
db_instance_class          = "db.t4g.micro"
db_allocated_storage       = 20
