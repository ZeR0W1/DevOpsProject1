// EKS-native CI pipeline for all three application services. The standalone
// CD job remains responsible for Helm deployment.
pipeline {
    agent none

    options {
        buildDiscarder(logRotator(numToKeepStr: '20'))
        disableConcurrentBuilds()
        skipDefaultCheckout(true)
    }

    stages {
        stage('Kubernetes CI') {
            agent {
                kubernetes {
                    defaultContainer 'python'
                    yaml '''
apiVersion: v1
kind: Pod
metadata:
  labels:
    app.kubernetes.io/part-of: devops-project1-ci
spec:
  serviceAccountName: jenkins-agent
  restartPolicy: Never
  securityContext:
    runAsNonRoot: true
    fsGroup: 1000
    seccompProfile:
      type: RuntimeDefault
  volumes:
    - name: docker-config
      emptyDir: {}
  containers:
    - name: jnlp
      image: zer0w1/devops-project1-jenkins-agent@sha256:c226666c65258fe952bc44375f489255d64845a20e3d6f55c297e4d7bd09050d
      resources:
        requests: {cpu: 100m, memory: 256Mi}
        limits: {cpu: 500m, memory: 512Mi}
      securityContext:
        runAsNonRoot: true
        runAsUser: 1000
        runAsGroup: 1000
        allowPrivilegeEscalation: false
        capabilities: {drop: ['ALL']}
    - name: python
      image: zer0w1/devops-project1-jenkins-agent:eks-python-v2
      command: ['cat']
      tty: true
      resources:
        requests: {cpu: 250m, memory: 512Mi}
        limits: {cpu: '1', memory: 1Gi}
      securityContext:
        runAsNonRoot: true
        runAsUser: 1000
        runAsGroup: 1000
        allowPrivilegeEscalation: false
        capabilities: {drop: ['ALL']}
    - name: kaniko
      image: zer0w1/devops-project1-jenkins-kaniko-agent:eks-v2
      command: ['cat']
      tty: true
      resources:
        requests: {cpu: 500m, memory: 1Gi}
        limits: {cpu: '2', memory: 3Gi}
      securityContext:
        runAsNonRoot: false
        runAsUser: 0
        runAsGroup: 0
        allowPrivilegeEscalation: false
        capabilities:
          drop: ['ALL']
          add: ['CHOWN', 'DAC_OVERRIDE', 'FOWNER']
      volumeMounts:
        - name: docker-config
          mountPath: /kaniko/.docker
    - name: helm
      # Jenkins durable-task does not reliably launch scripts in the
      # alpine/helm image. This image is already proven by the CD pipeline and
      # still runs the same helm lint/template commands below.
      image: alpine/k8s:1.34.3
      command: ['cat']
      tty: true
      env:
        - name: HOME
          value: /tmp
      resources:
        requests: {cpu: 100m, memory: 128Mi}
        limits: {cpu: 500m, memory: 512Mi}
      securityContext:
        runAsNonRoot: true
        runAsUser: 1000
        runAsGroup: 1000
        allowPrivilegeEscalation: false
        capabilities: {drop: ['ALL']}
    - name: trivy
      image: aquasec/trivy:0.57.1
      command: ['cat']
      tty: true
      env:
        - name: HOME
          value: /tmp
      resources:
        requests: {cpu: 250m, memory: 512Mi}
        limits: {cpu: '1', memory: 2Gi}
      securityContext:
        runAsNonRoot: true
        runAsUser: 1000
        runAsGroup: 1000
        allowPrivilegeEscalation: false
        capabilities: {drop: ['ALL']}
'''
                }
            }
            stages {
                stage('Checkout and Resolve Images') {
                    steps {
                        script {
                            env.APP_DIR_RESOLVED = params.APP_DIR
                            if (params.GIT_CREDENTIALS_ID?.trim()) {
                                checkout([$class: 'GitSCM', branches: [[name: params.REPO_BRANCH]], userRemoteConfigs: [[url: params.REPO_URL, credentialsId: params.GIT_CREDENTIALS_ID]]])
                            } else {
                                git branch: params.REPO_BRANCH, url: params.REPO_URL
                            }
                            env.GIT_FULL_SHA = sh(script: 'git rev-parse HEAD', returnStdout: true).trim()
                            env.GIT_SHORT_SHA = env.GIT_FULL_SHA.take(12)
                            env.GIT_AUTHOR_NAME_RESOLVED = sh(script: 'git show -s --format=%an HEAD', returnStdout: true).trim()
                            env.GIT_AUTHOR_EMAIL_RESOLVED = sh(script: 'git show -s --format=%ae HEAD', returnStdout: true).trim()
                            env.CI_TRIGGER_CAUSE_RESOLVED = currentBuild.getBuildCauses()
                                .collect { it.shortDescription ?: it._class ?: 'Unknown cause' }
                                .join('; ')
                            def deployDefault = params.DELIVERY_MODE == 'DEPLOY_DEFAULT'
                            def requestedTag = params.IMAGE_TAG?.trim()
                            env.IMAGE_TAG_RESOLVED = deployDefault ? (requestedTag ?: '3-c896ff25891a') : (requestedTag ?: "${env.BUILD_NUMBER}-${env.GIT_SHORT_SHA}")
                            if (env.IMAGE_TAG_RESOLVED == 'latest' || !(env.IMAGE_TAG_RESOLVED ==~ /[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}/)) {
                                error('IMAGE_TAG must be an immutable valid container tag and cannot be latest.')
                            }
                            def dockerhubNamespace = deployDefault ? 'zer0w1' : params.DOCKERHUB_NAMESPACE?.trim()?.toLowerCase()
                            if (!dockerhubNamespace || !(dockerhubNamespace ==~ /[a-z0-9]+(?:[._-][a-z0-9]+)*/)) {
                                error('DOCKERHUB_NAMESPACE must be a valid lowercase Docker Hub user or organization namespace.')
                            }
                            env.FRONTEND_IMAGE_REPOSITORY = "${dockerhubNamespace}/devops-project1-frontend"
                            env.BACKEND_IMAGE_REPOSITORY = "${dockerhubNamespace}/devops-project1-backend"
                            env.WORKER_IMAGE_REPOSITORY = "${dockerhubNamespace}/devops-project1-worker"
                            env.FRONTEND_CONTENT_SOURCE = "${env.APP_DIR_RESOLVED}/src/frontend/index.html"
                            if (!params.VALIDATE_ONLY) {
                                def contentBucket = params.FRONTEND_CONTENT_BUCKET?.trim()
                                def contentKey = params.FRONTEND_CONTENT_KEY?.trim()
                                if (!contentBucket || !(contentBucket ==~ /[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]/)) {
                                    error('FRONTEND_CONTENT_BUCKET must be a valid non-empty S3 bucket name for publishing runs.')
                                }
                                if (contentKey != 'index.html') {
                                    error('FRONTEND_CONTENT_KEY is restricted to index.html.')
                                }
                            }
                            currentBuild.displayName = "#${env.BUILD_NUMBER} ${params.DELIVERY_MODE}:${env.IMAGE_TAG_RESOLVED}"
                            echo "Resolved ${params.DELIVERY_MODE} images with tag ${env.IMAGE_TAG_RESOLVED}"
                        }
                    }
                }

                stage('Python Checks') {
                    when { expression { params.DELIVERY_MODE == 'BUILD_AND_DEPLOY' } }
                    steps {
                        dir(params.APP_DIR) {
                            sh '''#!/bin/sh
                                set -eu
                                python3 -m venv .venv-jenkins
                                . .venv-jenkins/bin/activate
                                python -m pip install --quiet --upgrade pip
                                pip install --quiet -r src/requirements-test.txt
                                [ ! -f requirements.txt ] || pip install --quiet -r requirements.txt
                                [ ! -f src/backend/requirements.txt ] || pip install --quiet -r src/backend/requirements.txt
                                [ ! -f src/worker/requirements.txt ] || pip install --quiet -r src/worker/requirements.txt
                                bandit -r src/backend src/worker --severity-level low --confidence-level medium -f json -o "${WORKSPACE}/bandit.json" || test $? -eq 1
                                flake8 src/backend src/worker --count --statistics || test $? -eq 1
                                if find src/backend src/worker -type f -name '*test*.py' | grep -q .; then
                                  pytest -q --junitxml="${WORKSPACE}/pytest-results.xml"
                                fi
                            '''
                        }
                    }
                    post {
                        always {
                            archiveArtifacts artifacts: 'bandit.json', allowEmptyArchive: true
                            junit testResults: 'pytest-results.xml', allowEmptyResults: true
                        }
                    }
                }

                stage('Trivy Filesystem Scan') {
                    when { expression { params.DELIVERY_MODE == 'BUILD_AND_DEPLOY' } }
                    steps {
                        container('trivy') {
                            sh '''#!/bin/sh
                                set -eu
                                trivy fs --scanners vuln,secret --severity HIGH,CRITICAL --exit-code 1 "${APP_DIR}"
                            '''
                        }
                    }
                }

                stage('Validate All Helm Charts') {
                    steps {
                        container('helm') {
                            sh '''#!/bin/sh
                                set -eu
                                mkdir -p rendered-manifests
                                for component in frontend backend worker; do
                                  case "$component" in
                                    frontend) repository="$FRONTEND_IMAGE_REPOSITORY" ;;
                                    backend) repository="$BACKEND_IMAGE_REPOSITORY" ;;
                                    worker) repository="$WORKER_IMAGE_REPOSITORY" ;;
                                  esac
                                  extra_args=''
                                  if [ "$component" = worker ]; then
                                    extra_args='--set database.postgresEnabled=false --set integrations.s3Enabled=false --set integrations.snsEnabled=false --set aws.s3BucketName= --set aws.snsTopicArn='
                                  fi
                                  helm lint "helm/${component}" \
                                    --set namespace="${DEPLOY_NAMESPACE}" \
                                    --set image.repository="$repository" \
                                    --set image.tag="${IMAGE_TAG_RESOLVED}" \
                                    $extra_args
                                  helm template "$component" "helm/${component}" \
                                    --namespace "${DEPLOY_NAMESPACE}" \
                                    --set namespace="${DEPLOY_NAMESPACE}" \
                                    --set image.repository="$repository" \
                                    --set image.tag="${IMAGE_TAG_RESOLVED}" \
                                    $extra_args > "rendered-manifests/${component}.yaml"
                                done
                            '''
                        }
                        archiveArtifacts artifacts: 'rendered-manifests/*.yaml', fingerprint: true
                    }
                }

                stage('Validate Frontend Default Content') {
                    steps {
                        container('helm') {
                            sh '''#!/bin/sh
                                set -eu
                                sh scripts/manage_frontend_content.sh validate "${FRONTEND_CONTENT_SOURCE}"
                            '''
                        }
                    }
                }

                stage('Kaniko Build and Push All Images') {
                    when { expression { !params.VALIDATE_ONLY && params.DELIVERY_MODE == 'BUILD_AND_DEPLOY' } }
                    steps {
                        withCredentials([usernamePassword(credentialsId: params.DOCKERHUB_CREDENTIALS_ID, usernameVariable: 'DOCKERHUB_USERNAME', passwordVariable: 'DOCKERHUB_TOKEN')]) {
                            container('kaniko') {
                                sh '''#!/bin/sh
                                    set -eu
                                    auth="$(printf '%s:%s' "$DOCKERHUB_USERNAME" "$DOCKERHUB_TOKEN" | base64 | tr -d '\\n')"
                                    printf '{"auths":{"https://index.docker.io/v1/":{"auth":"%s"}}}' "$auth" > /kaniko/.docker/config.json
                                    mkdir -p "${WORKSPACE}/image-digests"
                                    for component in frontend backend worker; do
                                      case "$component" in
                                        frontend) repository="$FRONTEND_IMAGE_REPOSITORY" ;;
                                        backend) repository="$BACKEND_IMAGE_REPOSITORY" ;;
                                        worker) repository="$WORKER_IMAGE_REPOSITORY" ;;
                                      esac
                                      /kaniko/executor \
                                        --context "dir://${WORKSPACE}/${APP_DIR_RESOLVED}" \
                                        --dockerfile "${WORKSPACE}/${APP_DIR_RESOLVED}/Dockerfile.${component}" \
                                        --destination "${repository}:${IMAGE_TAG_RESOLVED}" \
                                        --digest-file "${WORKSPACE}/image-digests/${component}.txt" \
                                        --snapshot-mode=redo \
                                        --cleanup
                                    done
                                    chown -R 1000:1000 "${WORKSPACE}/image-digests"
                                '''
                            }
                        }
                        archiveArtifacts artifacts: 'image-digests/*.txt', fingerprint: true
                    }
                }

                stage('Seed or Reset Frontend Content in S3') {
                    when { expression { !params.VALIDATE_ONLY } }
                    steps {
                        container('helm') {
                            sh '''#!/bin/sh
                                set -eu
                                test -n "${FRONTEND_CONTENT_BUCKET}"
                                test "${FRONTEND_CONTENT_KEY}" = index.html
                                overwrite="${OVERWRITE_FRONTEND_CONTENT}"
                                [ "${DELIVERY_MODE}" != DEPLOY_DEFAULT ] || overwrite=false
                                sh scripts/manage_frontend_content.sh seed \
                                  "${FRONTEND_CONTENT_SOURCE}" \
                                  "${FRONTEND_CONTENT_BUCKET}" \
                                  "${FRONTEND_CONTENT_KEY}" \
                                  "$overwrite" \
                                  "${AWS_REGION}"
                            '''
                        }
                    }
                }

                stage('Trigger Three-Service CD') {
                    when { expression { !params.VALIDATE_ONLY && params.DEPLOY_TO_EKS } }
                    steps {
                        script {
                            def cdJobName = params.CD_JOB_NAME?.trim()
                            if (!cdJobName) {
                                error('Cannot trigger CD: CD_JOB_NAME is empty.')
                            }
                            def sourceBuild = params.DELIVERY_MODE == 'BUILD_AND_DEPLOY'
                            def handoff = [
                                REPO_URL: params.REPO_URL?.trim(),
                                REPO_REF: env.GIT_FULL_SHA?.trim(),
                                GIT_CREDENTIALS_ID: params.GIT_CREDENTIALS_ID?.trim() ?: '',
                                FRONTEND_IMAGE_REPOSITORY: env.FRONTEND_IMAGE_REPOSITORY?.trim(),
                                BACKEND_IMAGE_REPOSITORY: env.BACKEND_IMAGE_REPOSITORY?.trim(),
                                WORKER_IMAGE_REPOSITORY: env.WORKER_IMAGE_REPOSITORY?.trim(),
                                IMAGE_TAG: env.IMAGE_TAG_RESOLVED?.trim(),
                                AWS_REGION: params.AWS_REGION?.trim(),
                                EKS_CLUSTER_NAME: params.EKS_CLUSTER_NAME?.trim(),
                                DEPLOY_NAMESPACE: params.DEPLOY_NAMESPACE?.trim(),
                                FRONTEND_CONTENT_BUCKET: params.FRONTEND_CONTENT_BUCKET?.trim(),
                                FRONTEND_CONTENT_KEY: params.FRONTEND_CONTENT_KEY?.trim(),
                                WORKER_DB_HOST: params.WORKER_DB_HOST?.trim(),
                                WORKER_DB_PORT: params.WORKER_DB_PORT?.trim(),
                                WORKER_DB_NAME: params.WORKER_DB_NAME?.trim(),
                                WORKER_DB_USER: params.WORKER_DB_USER?.trim(),
                                WORKER_DB_SECRET_NAME: params.WORKER_DB_SECRET_NAME?.trim(),
                                WORKER_S3_BUCKET: params.WORKER_S3_BUCKET?.trim(),
                                WORKER_SNS_TOPIC_ARN: params.WORKER_SNS_TOPIC_ARN?.trim(),
                                CI_JOB_NAME: env.JOB_NAME?.trim(),
                                CI_BUILD_NUMBER: env.BUILD_NUMBER?.trim(),
                                CI_BUILD_URL: env.BUILD_URL?.trim(),
                                CI_TRIGGER_CAUSE: env.CI_TRIGGER_CAUSE_RESOLVED?.trim(),
                                GIT_AUTHOR_NAME: env.GIT_AUTHOR_NAME_RESOLVED?.trim(),
                                GIT_AUTHOR_EMAIL: env.GIT_AUTHOR_EMAIL_RESOLVED?.trim(),
                                FRONTEND_IMAGE_DIGEST: sourceBuild ? readFile('image-digests/frontend.txt').trim() : '',
                                BACKEND_IMAGE_DIGEST: sourceBuild ? readFile('image-digests/backend.txt').trim() : '',
                                WORKER_IMAGE_DIGEST: sourceBuild ? readFile('image-digests/worker.txt').trim() : ''
                            ]
                            handoff.each { name, value ->
                                if (!(name in ['GIT_CREDENTIALS_ID', 'FRONTEND_IMAGE_DIGEST', 'BACKEND_IMAGE_DIGEST', 'WORKER_IMAGE_DIGEST']) && !value) {
                                    error("Cannot trigger CD: resolved ${name} is empty.")
                                }
                            }
                            if (sourceBuild) {
                                ['FRONTEND_IMAGE_DIGEST', 'BACKEND_IMAGE_DIGEST', 'WORKER_IMAGE_DIGEST'].each { name ->
                                    if (!(handoff[name] ==~ /sha256:[0-9a-f]{64}/)) {
                                        error("Cannot trigger CD: ${name} is not a valid immutable digest.")
                                    }
                                }
                            }
                            if (!(handoff.REPO_REF ==~ /[0-9a-f]{40}/)) {
                                error('Cannot trigger CD: REPO_REF is not a full Git commit SHA.')
                            }
                            echo "CD handoff: ref=${handoff.REPO_REF.take(12)}, tag=${handoff.IMAGE_TAG}, namespace=${handoff.DEPLOY_NAMESPACE}, services=frontend,backend,worker"
                            build job: cdJobName, wait: true, propagate: true, parameters: [
                                string(name: 'REPO_URL', value: handoff.REPO_URL),
                                string(name: 'REPO_REF', value: handoff.REPO_REF),
                                string(name: 'GIT_CREDENTIALS_ID', value: handoff.GIT_CREDENTIALS_ID),
                                string(name: 'FRONTEND_IMAGE_REPOSITORY', value: handoff.FRONTEND_IMAGE_REPOSITORY),
                                string(name: 'BACKEND_IMAGE_REPOSITORY', value: handoff.BACKEND_IMAGE_REPOSITORY),
                                string(name: 'WORKER_IMAGE_REPOSITORY', value: handoff.WORKER_IMAGE_REPOSITORY),
                                string(name: 'IMAGE_TAG', value: handoff.IMAGE_TAG),
                                string(name: 'AWS_REGION', value: handoff.AWS_REGION),
                                string(name: 'EKS_CLUSTER_NAME', value: handoff.EKS_CLUSTER_NAME),
                                string(name: 'DEPLOY_NAMESPACE', value: handoff.DEPLOY_NAMESPACE),
                                string(name: 'DEPLOY_MODE', value: 'FULL'),
                                string(name: 'FRONTEND_CONTENT_BUCKET', value: handoff.FRONTEND_CONTENT_BUCKET),
                                string(name: 'FRONTEND_CONTENT_KEY', value: handoff.FRONTEND_CONTENT_KEY),
                                string(name: 'WORKER_DB_HOST', value: handoff.WORKER_DB_HOST),
                                string(name: 'WORKER_DB_PORT', value: handoff.WORKER_DB_PORT),
                                string(name: 'WORKER_DB_NAME', value: handoff.WORKER_DB_NAME),
                                string(name: 'WORKER_DB_USER', value: handoff.WORKER_DB_USER),
                                string(name: 'WORKER_DB_SECRET_NAME', value: handoff.WORKER_DB_SECRET_NAME),
                                string(name: 'WORKER_S3_BUCKET', value: handoff.WORKER_S3_BUCKET),
                                string(name: 'WORKER_SNS_TOPIC_ARN', value: handoff.WORKER_SNS_TOPIC_ARN),
                                string(name: 'CI_JOB_NAME', value: handoff.CI_JOB_NAME),
                                string(name: 'CI_BUILD_NUMBER', value: handoff.CI_BUILD_NUMBER),
                                string(name: 'CI_BUILD_URL', value: handoff.CI_BUILD_URL),
                                string(name: 'CI_TRIGGER_CAUSE', value: handoff.CI_TRIGGER_CAUSE),
                                string(name: 'GIT_AUTHOR_NAME', value: handoff.GIT_AUTHOR_NAME),
                                string(name: 'GIT_AUTHOR_EMAIL', value: handoff.GIT_AUTHOR_EMAIL),
                                string(name: 'FRONTEND_IMAGE_DIGEST', value: handoff.FRONTEND_IMAGE_DIGEST),
                                string(name: 'BACKEND_IMAGE_DIGEST', value: handoff.BACKEND_IMAGE_DIGEST),
                                string(name: 'WORKER_IMAGE_DIGEST', value: handoff.WORKER_IMAGE_DIGEST),
                                booleanParam(name: 'CONFIRM_DEPLOY', value: true)
                            ]
                        }
                    }
                }
            }
            post {
                always {
                    script {
                        try {
                            container('kaniko') {
                                sh 'rm -f /kaniko/.docker/config.json'
                            }
                        } catch (Exception cleanupError) {
                            echo 'Kaniko credential cleanup could not exec because the short-lived container had already exited; the pod-scoped emptyDir is removed with the agent Pod.'
                        }
                    }
                    script {
                        try {
                            deleteDir()
                        } catch (Exception workspaceCleanupError) {
                            echo 'Workspace cleanup could not complete after the short-lived agent containers exited; the pod-scoped emptyDir is removed with the agent Pod.'
                        }
                    }
                }
            }
        }
    }
}
