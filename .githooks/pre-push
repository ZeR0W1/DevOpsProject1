#!/usr/bin/env bash
set -u

remote_name="${1:-}"
remote_url="${2:-}"

if [[ "$remote_name" != "origin" ]] ||
  [[ "$remote_url" != *"github.com"*"ZeR0W1/DevOpsProject1"* ]]; then
  cat >/dev/null
  exit 0
fi

check_required=false
while read -r _local_ref _local_sha remote_ref _remote_sha; do
  if [[ "$remote_ref" == "refs/heads/aws4-jenkins-cicd" ]]; then
    check_required=true
  fi
done

if [[ "$check_required" == true ]]; then
  project_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
  bash "${project_root}/scripts/check_github_hook_cidrs.sh" || true
fi

exit 0